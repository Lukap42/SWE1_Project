        <mxCell id="c9" value="Phase 2 (right side): enforcement. Every later request of the employee is checked on the server against the assigned role, so information tagged for other roles stays hidden (acceptance criterion of the “different roles, different permissions” story)." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFF2CC;strokeColor=#000000;size=14;" vertex="1" parent="1"><mxGeometry x="10" y="1030" width="270" height="130" as="geometry"/></mxCell>
